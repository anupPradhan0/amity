# —— Docker / PostgreSQL (copy to .env: `cp .env.example .env`) ——
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campus_merch
POSTGRES_PORT=5432
ADMINER_PORT=5050

# Published host ports: API and Vite must differ. Vite listens on 8080 inside the frontend container.
API_PORT=8000
FRONTEND_PORT=5173

# JWT signing (used by docker-compose `api` service)
SECRET_KEY=dev-secret-change-in-production

# Optional: passed to Compose `api` — bootstraps admin on startup (min 8 char password).
# ADMIN_EMAIL=admin@campus.local
# ADMIN_PASSWORD=your-secure-password-here

# SQLAlchemy/psycopg (local Python API). In Docker, compose sets its own DATABASE_URL for `api`.
DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5432/campus_merch

# —— Vite —— API origin as seen from the browser (match API_PORT when API runs on localhost).
# In local dev without this set, `frontend` uses the Vite `/api` proxy to http://127.0.0.1:8000.
VITE_API_URL=http://localhost:8000
