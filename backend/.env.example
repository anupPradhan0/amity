DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5432/campus_merch
SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_DAYS=7

# Optional: on every API startup, create or update this user (is_admin=true, password from env).
# Password must be at least 8 characters. Change these in production and keep .env private.
# ADMIN_EMAIL=admin@campus.local
# ADMIN_PASSWORD=your-secure-password-here

# After registering a user in the API, grant admin (PostgreSQL example):
# UPDATE users SET is_admin = TRUE WHERE email = 'your@email.com';

# Defaults in app/config.py allow localhost dev origins. Override with JSON array, e.g.:
# CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Catalog seed: insert demo products when `products` table is empty (default true).
# PRODUCT_SEED_FORCE=true upserts demo rows on every API boot (overwrites matching slugs; dev only).
# PRODUCT_SEED_ON_EMPTY=false
# PRODUCT_SEED_FORCE=false
